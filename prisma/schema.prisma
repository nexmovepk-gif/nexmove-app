// This is your Prisma schema file, // Updated with FinancialLedger, Expense, RentCollection models for Phase 3
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}


// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  PUBLIC_USER
  AGENCY_AGENT
  AGENCY_MANAGER
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  EXPIRED
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SHIELDED
  LOCKED
  SOLD
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum LedgerCategory {
  RENT
  COMMISSION
  SALARY
  MARKETING
  MAINTENANCE
  UTILITIES
  OTHER
}

enum DealStatus {
  PENDING
  LOCKED
  ESCROW
  CLOSED
  CANCELLED
}

enum PropertyPurpose {
  FOR_SALE
  FOR_RENT
  LEASE
}

// Phase 2 enums
enum PropertyType {
  HOUSE
  APARTMENT
  PLOT
  COMMERCIAL
  VILLA
}

enum ListingSource {
  PUBLIC_SELF  // Owner submitted directly
  AGENCY_LISTED
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  password            String?
  name                String?
  role                Role                @default(PUBLIC_USER)
  accountRoleType     String?             // e.g. BUYER, LOCAL_PUBLIC, OVERSEAS_BUYER, OVERSEAS_INVESTOR, AGENCY_ADMIN, AGENCY_AGENT
  subscriptionStatus  SubscriptionStatus  @default(ACTIVE)
  subscriptionEndDate DateTime?
  isKycVerified       Boolean             @default(false)
  cnicNumber          String?             // CNIC / National ID
  cnicFrontUrl        String?             // CNIC Front Photo URL / Storage Reference
  cnicBackUrl         String?             // CNIC Back Photo URL / Storage Reference
  nicopNumber         String?             // Overseas NICOP / National ID
  passportNumber      String?             // Overseas Passport Number for Foreign KYC
  overseasCountry     String?             // Overseas Country of residence
  overseasCity        String?             // Overseas City
  overseasPostalCode  String?             // Overseas Postal Code
  overseasDocPhoto    String?             // Overseas Document Photo URL
  isOverseasVerified  Boolean             @default(false)   // Overseas KYC status
  phone               String?
  address             String?
  liveSelfieUrl       String?             // Live Photo Capture / Selfie Verification URL
  profileImage        String?             // Profile Picture / Avatar URL
  taxIdNumber         String?             // FBR / Local Tax Identification Number (Optional/Overseas Investor)

  // Banking & Escrow Payout Information (with 6-month security cooldown)
  bankName            String?             // e.g. Meezan Bank, HBL, Roshan Digital Bank, Barclays
  accountTitle        String?             // Bank Account Title
  accountNumber       String?             // Bank Account Number / Card Number
  iban                String?             // IBAN Number (e.g. PK... or International IBAN)
  bankDetailsUpdatedAt DateTime?          // Cooldown tracking timestamp (180-day lock)

  agencyId            String?
  agency              Agency?             @relation(fields: [agencyId], references: [id])

  listings            Listing[]
  properties          Property[]
  clients             Client[]
  ledgers             FinancialLedger[]

  dealsBuyer          Deal[]              @relation("BuyerAgentRelation")
  dealsSeller         Deal[]              @relation("SellerAgentRelation")
  expenses            Expense[]
  rentCollections     RentCollection[]
  architectProfile    ArchitectProfile?
  savedListings       SavedListing[]
  investorPortfolios  InvestorPortfolio[]
  investorCashflows   InvestorCashflow[]
  investorWallet      InvestorWallet?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Agency {
  id                  String              @id @default(uuid())
  name                String
  licenseNumber       String?             @unique
  verified            Boolean             @default(false)    // Agency verified (Phase 1)
  verifiedLicense     Boolean             @default(false)    // Phase 2: Official license badge
  subscriptionStatus  SubscriptionStatus  @default(ACTIVE)
  subscriptionEndDate DateTime?
  isKycVerified       Boolean             @default(false)
  logo                String?
  phone               String?
  address             String?
  description         String?                              // Phase 2: Public profile bio
  ntn                 String?             // Legal Tax Registration Number (NTN)
  cnicNumber          String?             // Agency Owner CNIC Number
  cnicFrontUrl        String?             // Agency Owner CNIC Front Photo URL
  cnicBackUrl         String?             // Agency Owner CNIC Back Photo URL
  latitude            Float?              // Map location Latitude
  longitude           Float?              // Map location Longitude
  storefrontPhoto     String?             // Agency Storefront photo URL
  ownerPhoto          String?             // Agency Owner Passport/Identity photo URL
  commercialLicenseDoc String?            // Overseas Agency Tax Reg / Commercial License Document URL

  // Agency Official Escrow Payout Banking Information (with 6-month cooldown)
  bankName            String?             // Official Agency Payout Bank
  accountTitle        String?             // Official Agency Account Title
  accountNumber       String?             // Account Number
  iban                String?             // IBAN Number
  swiftCode           String?             // SWIFT / BIC Code (for foreign remittances)
  bankDetailsUpdatedAt DateTime?          // Cooldown tracking timestamp (180-day lock)

  users               User[]
  listings            Listing[]
  properties          Property[]
  publicListings      PublicListing[]
  clients             Client[]
  ledgers             FinancialLedger[]
  expenses          Expense[]
  rentCollections   RentCollection[]
  agencyReviews       AgencyReview[]
  deals               Deal[]


  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Listing {
  id                  String            @id @default(uuid())
  title               String
  description         String?
  price               Float
  address             String
  latitude            Float?
  longitude           Float?
  area                Float?
  roomCount           Int?
  verifiedDoc         Boolean           @default(false)

  agencyId            String
  agency              Agency            @relation(fields: [agencyId], references: [id])

  agentId             String
  agent               User              @relation(fields: [agentId], references: [id])

  status              ListingStatus     @default(DRAFT)
  deals               Deal[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

/// Comprehensive Property Model
model Property {
  id                  String            @id @default(uuid())
  title               String
  description         String?
  purpose             PropertyPurpose   @default(FOR_SALE) // For Sale, For Rent, Lease
  propertyType        String            // House, Flat / Apartment, Commercial Plot, Office, etc.
  category            String?           // HOMES, PLOTS, COMMERCIAL, OTHER
  price               Float             // Sale Price or Monthly Rent/Price
  address             String
  city                String?
  latitude            Float?
  longitude           Float?
  areaSqFt            Float?
  bedrooms            Int?
  bathrooms           Int?
  isAvailable         Boolean           @default(true)
  availableDate       DateTime?
  images              String[]          @default([])
  videoUrl            String?           // Video file upload or external URL (YouTube/Vimeo/MP4)
  panoramaUrl         String?           // 360 Panorama photo (.jpg)
  virtualTourUrl      String?           // 3D Virtual Tour URL (Matterport / Spline)
  features            String[]          @default([]) // Corner Property, Main Boulevard, Furnished, etc.
  contactName         String
  contactPhone        String
  contactEmail        String?

  agencyId            String?
  agency              Agency?           @relation(fields: [agencyId], references: [id])

  userId              String?
  user                User?             @relation(fields: [userId], references: [id])

  status              ListingStatus     @default(ACTIVE)
  savedListings       SavedListing[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// ─── Phase 2 Models ──────────────────────────────────────────────────────────

/// Public self-listing: submitted by property owners without an agency account.
model PublicListing {
  id                  String            @id @default(uuid())
  title               String
  description         String?
  purpose             PropertyPurpose   @default(FOR_SALE)
  propertyType        PropertyType      @default(HOUSE)
  source              ListingSource     @default(PUBLIC_SELF)
  price               Float
  address             String
  city                String?
  latitude            Float?
  longitude           Float?
  areaSqFt            Float?
  bedrooms            Int?
  bathrooms           Int?
  isAvailable         Boolean           @default(true)
  availableDate       DateTime?
  images              String[]          @default([]) // Cloudinary/S3 URLs (Phase 3 integration)
  videoUrl            String?
  panoramaUrl         String?
  virtualTourUrl      String?
  features            String[]          @default([])
  contactName         String
  contactPhone        String
  contactEmail        String?

  // Verification badges
  verifiedProperty    Boolean           @default(false)   // Admin-verified legal docs
  aiExtracted         Boolean           @default(false)   // AI auto-filled fields
  aiConfidence        Float?                              // 0–1 confidence score
  aiRawData           String?                             // JSON blob of extracted metadata

  // Optional agency association (for agency-sourced public listings)
  agencyId            String?
  agency              Agency?           @relation(fields: [agencyId], references: [id])

  isActive            Boolean           @default(true)
  savedListings       SavedListing[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

/// Overseas Buyer saved / bookmarked listings for their dashboard
model SavedListing {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Link to either agency Property OR public self-listing
  propertyId        String?
  property          Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  publicListingId   String?
  publicListing     PublicListing? @relation(fields: [publicListingId], references: [id], onDelete: Cascade)

  note              String?       // Optional buyer note
  savedAt           DateTime      @default(now())

  @@unique([userId, propertyId])
  @@unique([userId, publicListingId])
}

/// Public reviews left by users on agencies.
model AgencyReview {
  id                  String            @id @default(uuid())
  agencyId            String
  agency              Agency            @relation(fields: [agencyId], references: [id])

  reviewerName        String
  reviewerEmail       String?
  rating              Int               // 1 to 5
  comment             String?
  isVerified          Boolean           @default(false)   // Admin-verified review

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// ─── Existing Phase 1 Models (unchanged) ─────────────────────────────────────

model Client {
  id                  String            @id @default(uuid())
  name                String
  phone               String
  email               String?
  requirements        String?
  budget              Float?

  agencyId            String
  agency              Agency            @relation(fields: [agencyId], references: [id])

  agentId             String
  agent               User              @relation(fields: [agentId], references: [id])

  status              String            @default("LEAD")
  deals               Deal[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model FinancialLedger {
  id                  String            @id @default(uuid())
  type                LedgerType
  category            LedgerCategory
  amount              Float
  description         String?
  date                DateTime          @default(now())

  agencyId            String
  agency              Agency            @relation(fields: [agencyId], references: [id])

  createdById         String
  createdBy           User              @relation(fields: [createdById], references: [id])

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Deal {
  id                  String            @id @default(uuid())
  listingId           String
  listing             Listing           @relation(fields: [listingId], references: [id])

  buyerClientId       String?
  buyerClient         Client?           @relation(fields: [buyerClientId], references: [id])

  buyerAgentId        String?
  buyerAgent          User?             @relation("BuyerAgentRelation", fields: [buyerAgentId], references: [id])

  sellerAgentId       String
  sellerAgent         User              @relation("SellerAgentRelation", fields: [sellerAgentId], references: [id])

  agencyId            String
  agency              Agency            @relation(fields: [agencyId], references: [id])

  status              DealStatus        @default(PENDING)
  agreementDoc        String?
  tokenAmount         Float?
  commissionSeller    Float?
  commissionBuyer     Float?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// ─── Phase 3 Models ──────────────────────────────────────────────────────────
model Expense {
  id            String   @id @default(uuid())
  amount        Float
  description   String?
  date          DateTime @default(now())

  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])

  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RentCollection {
  id            String   @id @default(uuid())
  amount        Float
  month         Int      // e.g., 1-12
  year          Int
  description   String?
  dateCollected DateTime @default(now())

  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])

  collectedById String
  collectedBy   User     @relation(fields: [collectedById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Architect & Designer Models ─────────────────────────────────────────────

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Professional architect/designer profile submitted via the registration flow.
model ArchitectProfile {
  id                   String             @id @default(uuid())
  userId               String?            @unique
  user                 User?              @relation(fields: [userId], references: [id])
  name                 String
  title                String?
  specialization       String
  companyName          String?
  bio                  String?
  phone                String?
  isOverseas           Boolean            @default(false)
  country              String?
  city                 String?
  pcatpNo              String?
  status               String             @default("PENDING") // PENDING, APPROVED, REJECTED
  isVerified           Boolean            @default(false)
  verificationStatus   String             @default("PENDING") // PENDING | VERIFIED | REJECTED
  experienceYears      Int?
  experienceLevel      String?            // Junior | Mid-Level | Senior | Principal
  location             String?
  software             String[]
  projectTypes         String[]
  portfolioImages      String[]
  portfolioLinks       String[]
  portfolioUrl         String?
  availableForProjects Boolean            @default(true)
  councilLicenseNo     String?
  avatarInitials       String?
  avatarGradient       String?
  avatarUrl            String?
  coverImage           String?
  coverBannerUrl       String?

  reviews              ArchitectReview[]
  projects             ArchitectProject[]

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

/// Review left on an architect's profile by a client or agency.
model ArchitectReview {
  id            String           @id @default(uuid())
  architectId   String
  architect     ArchitectProfile @relation(fields: [architectId], references: [id], onDelete: Cascade)
  reviewerName  String
  reviewerEmail String?
  rating        Float            // 1.0 – 5.0
  comment       String?
  isVerified    Boolean          @default(false)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// Project record linked to an architect profile, used for portfolio and stats aggregation.
model ArchitectProject {
  id            String           @id @default(uuid())
  architectId   String
  architect     ArchitectProfile @relation(fields: [architectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  category      String?
  software      String[]         @default([])
  imageUrl      String?
  imageUrls     String[]         @default([])
  videoUrl      String?
  tags          String[]         @default([])
  likesCount    Int              @default(0)
  completedYear Int?
  status        ProjectStatus    @default(COMPLETED)
  completedAt   DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ─── Investor Portal Models ───────────────────────────────────────────────────

enum InvestmentDealStatus {
  ACTIVE
  RESERVED
  FUNDED
}

enum InvestorPortfolioStatus {
  ACTIVE
  PENDING_RENEWAL
  EXITED
}

enum CashflowType {
  RENTAL_INCOME
  PROFIT_DISTRIBUTION
  CAPITAL_EXIT
}

enum CashflowStatus {
  COMPLETED
  PROCESSING
}

/// Off-market / distress property deals listed by verified agencies for investors
model InvestmentDeal {
  id                  String                @id @default(uuid())
  title               String
  location            String
  city                String
  propertyType        String
  pricePKR            Float
  marketValuationPKR  Float
  discountPct         Float                 @default(0)
  rentalYieldPct      Float                 @default(0)
  capitalGrowth3YrPct Float                 @default(0)
  roiScore            Int                   @default(0)
  isDistress          Boolean               @default(false)
  isOffMarket         Boolean               @default(false)
  escrowSecured       Boolean               @default(true)
  image               String?
  agencyName          String
  agencyId            String?
  status              InvestmentDealStatus  @default(ACTIVE)
  portfolios          InvestorPortfolio[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

/// An investor's confirmed holding in a specific deal
model InvestorPortfolio {
  id                  String                   @id @default(uuid())
  userId              String
  user                User                     @relation(fields: [userId], references: [id])
  dealId              String
  deal                InvestmentDeal           @relation(fields: [dealId], references: [id])
  propertyTitle       String
  location            String
  city                String
  propertyType        String
  image               String?
  status              InvestorPortfolioStatus  @default(ACTIVE)
  startDate           DateTime                 @default(now())
  maturityDate        DateTime
  investedAmountPKR   Float
  currentValuePKR     Float
  equitySharePct      Float
  fixedRoiPct         Float
  monthlyYieldPKR     Float
  agencyName          String
  contractPdfName     String?
  exitDate            DateTime?
  finalSaleValuePKR   Float?
  netCapitalGainsPKR  Float?
  totalRoiPct         Float?
  cashflows           InvestorCashflow[]

  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

/// Financial ledger: rental income, profit distributions, capital exits
model InvestorCashflow {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  portfolioId     String?
  portfolio       InvestorPortfolio? @relation(fields: [portfolioId], references: [id])
  propertyTitle   String
  type            CashflowType
  grossAmountPKR  Float
  fbrTaxPKR       Float              @default(0)
  netPayoutPKR    Float
  paymentMethod   String?
  receiptId       String?
  status          CashflowStatus     @default(COMPLETED)
  date            DateTime           @default(now())

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

/// Escrow wallet balance per investor user
model InvestorWallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  balancePKR  Float    @default(0)
  pendingPKR  Float    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Password Reset ───────────────────────────────────────────────────────────

/// Secure time-limited token for forgot-password / account recovery flow
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
